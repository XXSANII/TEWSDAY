NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tewsday_app:local_app_only@localhost:55432/tewsday?schema=public
# Migrations must use the schema owner, not the restricted runtime account.
MIGRATION_DATABASE_URL=postgresql://tewsday_owner:local_owner_only@localhost:55432/tewsday?schema=public
REDIS_URL=redis://localhost:56379
# Generate a fresh secret for each environment; do not use this sample in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=tewsday-api
JWT_AUDIENCE=tewsday-web
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
