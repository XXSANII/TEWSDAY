model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model storage_files {
  id                                                                         String                           @id @db.VarChar(36)
  bucket_name                                                                String                           @db.VarChar(100)
  file_key                                                                   String                           @unique
  file_name                                                                  String                           @db.VarChar(255)
  mime_type                                                                  String                           @db.VarChar(100)
  file_size_bytes                                                            BigInt
  file_category                                                              storage_files_file_category_enum
  is_active                                                                  Boolean                          @default(true)
  created_by                                                                 String?                          @db.VarChar(36)
  updated_by                                                                 String?                          @db.VarChar(36)
  created_at                                                                 DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                                                                 DateTime                         @default(now()) @db.Timestamptz(6)
  bookings                                                                   bookings[]
  invoices                                                                   invoices[]
  messages_messages_file_idTostorage_files                                   messages[]                       @relation("messages_file_idTostorage_files")
  messages_messages_thumbnail_file_idTostorage_files                         messages[]                       @relation("messages_thumbnail_file_idTostorage_files")
  profile_change_requests                                                    profile_change_requests[]
  question_answers                                                           question_answers[]
  users_storage_files_created_byTousers                                      users?                           @relation("storage_files_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_storage_files_updated_byTousers                                      users?                           @relation("storage_files_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  student_questions                                                          student_questions[]
  tutor_education                                                            tutor_education[]
  tutor_profiles_tutor_profiles_intro_video_file_idTostorage_files           tutor_profiles[]                 @relation("tutor_profiles_intro_video_file_idTostorage_files")
  tutor_profiles_tutor_profiles_intro_video_thumbnail_file_idTostorage_files tutor_profiles[]                 @relation("tutor_profiles_intro_video_thumbnail_file_idTostorage_files")
  users_users_avatar_file_idTostorage_files                                  users[]                          @relation("users_avatar_file_idTostorage_files")
}

model student_jobs {
  id                                   String                          @id @db.VarChar(36)
  student_id                           String                          @db.VarChar(36)
  subject_id                           String                          @db.VarChar(36)
  target_grade_level                   String                          @db.VarChar(50)
  target_topics                        String[]                        @default([])
  learning_goal                        String
  budget_min                           Decimal                         @db.Decimal(10, 2)
  budget_max                           Decimal                         @db.Decimal(10, 2)
  location_type                        student_jobs_location_type_enum
  location                             Unsupported("geometry")?
  frequency_per_week                   Int                             @db.SmallInt
  preferred_days                       Int[]                           @db.SmallInt
  status                               student_jobs_status_enum
  share_count                          Int                             @default(0)
  is_active                            Boolean                         @default(true)
  created_by                           String?                         @db.VarChar(36)
  updated_by                           String?                         @db.VarChar(36)
  created_at                           DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime                        @default(now()) @db.Timestamptz(6)
  bookings                             bookings[]
  job_applications                     job_applications[]
  users_student_jobs_created_byTousers users?                          @relation("student_jobs_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_profiles                     student_profiles                @relation(fields: [student_id], references: [id])
  subjects                             subjects                        @relation(fields: [subject_id], references: [id])
  users_student_jobs_updated_byTousers users?                          @relation("student_jobs_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
}

model student_profiles {
  id                                       String                  @id @db.VarChar(36)
  user_id                                  String                  @unique @db.VarChar(36)
  first_name                               String                  @db.VarChar(100)
  last_name                                String                  @db.VarChar(100)
  current_grade_level                      String                  @db.VarChar(50)
  school_name                              String                  @db.VarChar(150)
  location                                 Unsupported("geometry")
  parent_name                              String?                 @db.VarChar(150)
  parent_phone_number                      String?                 @db.VarChar(30)
  parent_relationship                      String?                 @db.VarChar(50)
  emergency_contact_name                   String?                 @db.VarChar(150)
  emergency_contact_phone                  String?                 @db.VarChar(30)
  emergency_contact_relationship           String?                 @db.VarChar(50)
  is_active                                Boolean                 @default(true)
  created_by                               String?                 @db.VarChar(36)
  updated_by                               String?                 @db.VarChar(36)
  created_at                               DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                @default(now()) @db.Timestamptz(6)
  bookings                                 bookings[]
  class_sessions                           class_sessions[]
  conversations                            conversations[]
  student_jobs                             student_jobs[]
  users_student_profiles_created_byTousers users?                  @relation("student_profiles_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_student_profiles_updated_byTousers users?                  @relation("student_profiles_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  users_student_profiles_user_idTousers    users                   @relation("student_profiles_user_idTousers", fields: [user_id], references: [id])
  student_questions                        student_questions[]
}

model student_questions {
  id                                        String                        @id @db.VarChar(36)
  student_id                                String                        @db.VarChar(36)
  subject_id                                String                        @db.VarChar(36)
  target_topics                             String[]                      @default([])
  title                                     String                        @db.VarChar(200)
  content                                   String
  question_image_file_id                    String?                       @db.VarChar(36)
  status                                    student_questions_status_enum @default(OPEN)
  view_count                                Int                           @default(0)
  answers_count                             Int                           @default(0)
  share_count                               Int                           @default(0)
  is_active                                 Boolean                       @default(true)
  created_by                                String?                       @db.VarChar(36)
  updated_by                                String?                       @db.VarChar(36)
  created_at                                DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                      @default(now()) @db.Timestamptz(6)
