generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bookings {
  id                               String                      @id @db.VarChar(36)
  student_id                       String                      @db.VarChar(36)
  tutor_id                         String                      @db.VarChar(36)
  subject_id                       String                      @db.VarChar(36)
  originating_job_id               String?                     @db.VarChar(36)
  agreed_hourly_rate               Decimal                     @db.Decimal(10, 2)
  location_type                    bookings_location_type_enum
  meeting_location                 String?
  meeting_url                      String?
  signed_contract_file_id          String?                     @db.VarChar(36)
  contract_uploaded_at             DateTime?                   @db.Timestamptz(6)
  status                           bookings_status_enum
  is_active                        Boolean                     @default(true)
  created_by                       String?                     @db.VarChar(36)
  updated_by                       String?                     @db.VarChar(36)
  created_at                       DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                    @default(now()) @db.Timestamptz(6)
  users_bookings_created_byTousers users?                      @relation("bookings_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_jobs                     student_jobs?               @relation(fields: [originating_job_id], references: [id], onDelete: Restrict)
  storage_files                    storage_files?              @relation(fields: [signed_contract_file_id], references: [id], onDelete: Restrict)
  student_profiles                 student_profiles            @relation(fields: [student_id], references: [id])
  subjects                         subjects                    @relation(fields: [subject_id], references: [id])
  tutor_profiles                   tutor_profiles              @relation(fields: [tutor_id], references: [id])
  users_bookings_updated_byTousers users?                      @relation("bookings_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  class_sessions                   class_sessions[]
  conversations                    conversations[]
  invoices                         invoices[]

  @@index([originating_job_id, student_id, tutor_id], map: "booking_job_lookup")
}

model class_sessions {
  id                                     String                             @id @db.VarChar(36)
  booking_id                             String                             @db.VarChar(36)
  student_id                             String                             @db.VarChar(36)
  tutor_id                               String                             @db.VarChar(36)
  scheduled_start                        DateTime                           @db.Timestamptz(6)
  scheduled_end                          DateTime                           @db.Timestamptz(6)
  actual_start                           DateTime?                          @db.Timestamptz(6)
  actual_end                             DateTime?                          @db.Timestamptz(6)
  hourly_rate                            Decimal                            @db.Decimal(10, 2)
  duration_minutes                       Int                                @default(60) @db.SmallInt
  gross_amount                           Decimal                            @db.Decimal(10, 2)
  session_feedback                       String?
  homework_assigned                      String?
  status                                 class_sessions_status_enum
  payment_status                         class_sessions_payment_status_enum
  dispute_reason                         String?
  student_confirmed_at                   DateTime?                          @db.Timestamptz(6)
  tutor_confirmed_at                     DateTime?                          @db.Timestamptz(6)
  is_active                              Boolean                            @default(true)
  created_by                             String?                            @db.VarChar(36)
  updated_by                             String?                            @db.VarChar(36)
  created_at                             DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime                           @default(now()) @db.Timestamptz(6)
  bookings                               bookings                           @relation(fields: [booking_id], references: [id])
  users_class_sessions_created_byTousers users?                             @relation("class_sessions_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_profiles                       student_profiles                   @relation(fields: [student_id], references: [id])
  tutor_profiles                         tutor_profiles                     @relation(fields: [tutor_id], references: [id])
  users_class_sessions_updated_byTousers users?                             @relation("class_sessions_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  invoices                               invoices[]
  reviews                                reviews[]
}

model conversations {
  id                                    String           @id @db.VarChar(36)
  booking_id                            String?          @db.VarChar(36)
  student_id                            String           @db.VarChar(36)
  tutor_id                              String           @db.VarChar(36)
  last_message_at                       DateTime?        @db.Timestamptz(6)
  is_active                             Boolean          @default(true)
  created_by                            String?          @db.VarChar(36)
  updated_by                            String?          @db.VarChar(36)
  created_at                            DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime         @default(now()) @db.Timestamptz(6)
  bookings                              bookings?        @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  users_conversations_created_byTousers users?           @relation("conversations_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_profiles                      student_profiles @relation(fields: [student_id], references: [id])
  tutor_profiles                        tutor_profiles   @relation(fields: [tutor_id], references: [id])
  users_conversations_updated_byTousers users?           @relation("conversations_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  messages                              messages[]
}

model entity_audit_logs {
  id                                        String                        @id @db.VarChar(36)
  table_name                                String                        @db.VarChar(64)
  record_id                                 String                        @db.VarChar(36)
  action                                    entity_audit_logs_action_enum
  old_data                                  Json?
  new_data                                  Json?
  changed_fields                            Json?
  changed_by                                String?                       @db.VarChar(36)
  is_active                                 Boolean                       @default(true)
  created_by                                String?                       @db.VarChar(36)
  updated_by                                String?                       @db.VarChar(36)
  created_at                                DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                      @default(now()) @db.Timestamptz(6)
  users_entity_audit_logs_changed_byTousers users?                        @relation("entity_audit_logs_changed_byTousers", fields: [changed_by], references: [id], onDelete: Restrict)
  users_entity_audit_logs_created_byTousers users?                        @relation("entity_audit_logs_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_entity_audit_logs_updated_byTousers users?                        @relation("entity_audit_logs_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)

  @@index([table_name, record_id, created_at], map: "audit_lookup")
}

model invoices {
  id                                  String                        @id @db.VarChar(36)
  invoice_number                      String                        @unique @db.VarChar(50)
  invoice_type                        invoices_invoice_type_enum
  booking_id                          String?                       @db.VarChar(36)
  class_session_id                    String?                       @db.VarChar(36)
  payer_user_id                       String                        @db.VarChar(36)
  payee_user_id                       String                        @db.VarChar(36)
  amount                              Decimal                       @db.Decimal(10, 2)
  commission_fee                      Decimal                       @default(0) @db.Decimal(10, 2)
  status                              invoices_status_enum          @default(UNPAID)
  payment_method                      invoices_payment_method_enum?
  slip_file_id                        String?                       @db.VarChar(36)
  due_date                            DateTime?                     @db.Date
  paid_at                             DateTime?                     @db.Timestamptz(6)
  verified_by                         String?                       @db.VarChar(36)
  is_active                           Boolean                       @default(true)
  created_by                          String?                       @db.VarChar(36)
  updated_by                          String?                       @db.VarChar(36)
  created_at                          DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                      @default(now()) @db.Timestamptz(6)
  bookings                            bookings?                     @relation(fields: [booking_id], references: [id], onDelete: Restrict)
  class_sessions                      class_sessions?               @relation(fields: [class_session_id], references: [id], onDelete: Restrict)
  users_invoices_created_byTousers    users?                        @relation("invoices_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_invoices_payee_user_idTousers users                         @relation("invoices_payee_user_idTousers", fields: [payee_user_id], references: [id])
  users_invoices_payer_user_idTousers users                         @relation("invoices_payer_user_idTousers", fields: [payer_user_id], references: [id])
  storage_files                       storage_files?                @relation(fields: [slip_file_id], references: [id], onDelete: Restrict)
  users_invoices_updated_byTousers    users?                        @relation("invoices_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  users_invoices_verified_byTousers   users?                        @relation("invoices_verified_byTousers", fields: [verified_by], references: [id], onDelete: Restrict)
}

model job_applications {
  id                                       String                       @id @db.VarChar(36)
  job_id                                   String                       @db.VarChar(36)
  tutor_id                                 String                       @db.VarChar(36)
  proposed_rate                            Decimal                      @db.Decimal(10, 2)
  cover_message                            String
  status                                   job_applications_status_enum
  is_active                                Boolean                      @default(true)
  created_by                               String?                      @db.VarChar(36)
  updated_by                               String?                      @db.VarChar(36)
  created_at                               DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                     @default(now()) @db.Timestamptz(6)
  users_job_applications_created_byTousers users?                       @relation("job_applications_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_jobs                             student_jobs                 @relation(fields: [job_id], references: [id])
  tutor_profiles                           tutor_profiles               @relation(fields: [tutor_id], references: [id])
  users_job_applications_updated_byTousers users?                       @relation("job_applications_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)

  @@index([job_id, tutor_id], map: "application_lookup")
}

model messages {
  id                                                      String                     @id @db.VarChar(36)
  conversation_id                                         String                     @db.VarChar(36)
  sender_id                                               String                     @db.VarChar(36)
  content                                                 String?
  message_type                                            messages_message_type_enum @default(TEXT)
  file_id                                                 String?                    @db.VarChar(36)
  thumbnail_file_id                                       String?                    @db.VarChar(36)
  is_read                                                 Boolean                    @default(false)
  is_active                                               Boolean                    @default(true)
  created_by                                              String?                    @db.VarChar(36)
  updated_by                                              String?                    @db.VarChar(36)
  created_at                                              DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                              DateTime                   @default(now()) @db.Timestamptz(6)
  conversations                                           conversations              @relation(fields: [conversation_id], references: [id])
  users_messages_created_byTousers                        users?                     @relation("messages_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  storage_files_messages_file_idTostorage_files           storage_files?             @relation("messages_file_idTostorage_files", fields: [file_id], references: [id], onDelete: Restrict)
  users_messages_sender_idTousers                         users                      @relation("messages_sender_idTousers", fields: [sender_id], references: [id])
  storage_files_messages_thumbnail_file_idTostorage_files storage_files?             @relation("messages_thumbnail_file_idTostorage_files", fields: [thumbnail_file_id], references: [id], onDelete: Restrict)
  users_messages_updated_byTousers                        users?                     @relation("messages_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
}

model notifications {
  id                                    String                           @id @db.VarChar(36)
  user_id                               String                           @db.VarChar(36)
  title                                 String                           @db.VarChar(150)
  body                                  String
  type                                  String                           @db.VarChar(50)
  priority_tier                         notifications_priority_tier_enum @default(NORMAL)
  reference_type                        String?                          @db.VarChar(50)
  reference_id                          String?                          @db.VarChar(36)
  is_read                               Boolean                          @default(false)
  is_active                             Boolean                          @default(true)
  created_by                            String?                          @db.VarChar(36)
  updated_by                            String?                          @db.VarChar(36)
  created_at                            DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime                         @default(now()) @db.Timestamptz(6)
  users_notifications_created_byTousers users?                           @relation("notifications_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_notifications_updated_byTousers users?                           @relation("notifications_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  users_notifications_user_idTousers    users                            @relation("notifications_user_idTousers", fields: [user_id], references: [id])
}

model profile_change_requests {
  id                                               String                                    @id @db.VarChar(36)
  tutor_id                                         String                                    @db.VarChar(36)
  user_id                                          String                                    @db.VarChar(36)
  request_type                                     profile_change_requests_request_type_enum
  current_data                                     Json
  requested_changes                                Json
  supporting_document_file_id                      String?                                   @db.VarChar(36)
  status                                           profile_change_requests_status_enum       @default(PENDING)
  rejection_reason                                 String?
  reviewed_by                                      String?                                   @db.VarChar(36)
  reviewed_at                                      DateTime?                                 @db.Timestamptz(6)
  is_active                                        Boolean                                   @default(true)
  created_by                                       String?                                   @db.VarChar(36)
  updated_by                                       String?                                   @db.VarChar(36)
  created_at                                       DateTime                                  @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime                                  @default(now()) @db.Timestamptz(6)
  users_profile_change_requests_created_byTousers  users?                                    @relation("profile_change_requests_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  users_profile_change_requests_reviewed_byTousers users?                                    @relation("profile_change_requests_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: Restrict)
  storage_files                                    storage_files?                            @relation(fields: [supporting_document_file_id], references: [id], onDelete: Restrict)
  tutor_profiles                                   tutor_profiles                            @relation(fields: [tutor_id], references: [id])
  users_profile_change_requests_updated_byTousers  users?                                    @relation("profile_change_requests_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
  users_profile_change_requests_user_idTousers     users                                     @relation("profile_change_requests_user_idTousers", fields: [user_id], references: [id])
}

model question_answers {
  id                                       String            @id @db.VarChar(36)
  question_id                              String            @db.VarChar(36)
  tutor_id                                 String            @db.VarChar(36)
  content                                  String
  solution_file_id                         String?           @db.VarChar(36)
  is_accepted                              Boolean           @default(false)
  accepted_at                              DateTime?         @db.Timestamptz(6)
  upvote_count                             Int               @default(0)
  is_active                                Boolean           @default(true)
  created_by                               String?           @db.VarChar(36)
  updated_by                               String?           @db.VarChar(36)
  created_at                               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime          @default(now()) @db.Timestamptz(6)
  users_question_answers_created_byTousers users?            @relation("question_answers_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict)
  student_questions                        student_questions @relation(fields: [question_id], references: [id])
  storage_files                            storage_files?    @relation(fields: [solution_file_id], references: [id], onDelete: Restrict)
  tutor_profiles                           tutor_profiles    @relation(fields: [tutor_id], references: [id])
  users_question_answers_updated_byTousers users?            @relation("question_answers_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict)
}

